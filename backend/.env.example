# ToolXr Backend — Environment Variables
# Copy this file to .env and fill in your values
# cp .env.example .env

# Server port (default: 3001)
PORT=3001

# Max file upload size in MB (default: 50)
MAX_FILE_SIZE_MB=50

# Auto-cleanup interval in minutes (default: 30)
CLEANUP_INTERVAL_MINUTES=30

# Allowed CORS origins (* = all, or specify your domain)
CORS_ORIGIN=*

# Optional: your domain (used for logging)
SITE_URL=http://localhost:3001
